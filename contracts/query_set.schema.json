{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://environmental-audio-rag.local/contracts/query_set.schema.json",
  "title": "Retrieval query set (v2, ADR-0027)",
  "type": "array",
  "minItems": 100,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["query_id", "group", "question", "question_vi", "filters", "support_train", "relevance"],
    "properties": {
      "query_id": {"type": "string", "pattern": "^q-[0-9]{3}$"},
      "group": {"enum": ["single_class", "multi_class", "temporal", "duration"]},
      "question": {"type": "string", "minLength": 1},
      "question_vi": {"type": "string", "minLength": 1},
      "support_train": {"type": "integer", "minimum": 1, "description": "Train recordings satisfying the filters — the selection criterion; dev/test never consulted."},
      "filters": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "classes_all": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
          "temporal": {
            "type": "object",
            "required": ["predicate", "a", "b", "tolerance_s"],
            "properties": {
              "predicate": {"enum": ["before", "after", "overlaps", "within"]},
              "a": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
              "b": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
              "tolerance_s": {"type": "number", "minimum": 0}
            }
          },
          "duration": {
            "type": "object",
            "required": ["class_id", "min_s"],
            "properties": {
              "class_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
              "min_s": {"type": "number", "exclusiveMinimum": 0}
            }
          }
        }
      },
      "relevance": {
        "type": "object",
        "description": "Relevant = recordings whose GROUND-TRUTH events satisfy `filters` (evaluation_protocol §9.1), computed by ml.retrieval.relevance — never by the filter under evaluation.",
        "required": ["type", "source"],
        "properties": {
          "type": {"const": "recording_ids"},
          "source": {"const": "ground_truth"}
        }
      }
    }
  }
}
