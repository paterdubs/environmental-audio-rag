{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://environmental-audio-rag.local/contracts/recording.schema.json",
  "title": "Recording",
  "description": "Metadata and provenance for one audio recording.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recording_id",
    "source_dataset",
    "source_id",
    "duration_s",
    "sample_rate",
    "channels",
    "sha256",
    "split",
    "captured_at",
    "ingested_at",
    "audio_path"
  ],
  "properties": {
    "recording_id": {
      "type": "string",
      "pattern": "^(datased|datasec|upload):.+$"
    },
    "source_dataset": {
      "type": "string",
      "enum": ["datased", "datasec", "upload"]
    },
    "source_id": {"type": "string", "minLength": 1},
    "duration_s": {"type": "number", "exclusiveMinimum": 0},
    "sample_rate": {"type": "integer", "minimum": 1},
    "channels": {"type": "integer", "minimum": 1},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "split": {"type": ["string", "null"], "enum": ["train", "validation", "test", null]},
    "captured_at": {"type": ["string", "null"], "format": "date-time"},
    "ingested_at": {"type": "string", "format": "date-time"},
    "audio_path": {"type": ["string", "null"]}
  }
}
