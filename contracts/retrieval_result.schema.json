{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://environmental-audio-rag.local/contracts/retrieval_result.schema.json",
  "title": "Retrieval result",
  "description": "A grounded retrieval answer with applied filters and event-level evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["question", "filters_applied", "answer", "evidence", "documents"],
  "properties": {
    "question": {"type": "string", "minLength": 1},
    "filters_applied": {"type": "object"},
    "answer": {"type": "string"},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["recording_id", "event_id", "class_id", "onset_s", "offset_s"],
        "properties": {
          "recording_id": {"type": "string", "pattern": "^(datased|datasec|upload):.+$"},
          "event_id": {"type": "integer", "minimum": 1},
          "class_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "onset_s": {"type": "number", "minimum": 0},
          "offset_s": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["recording_id", "text", "score"],
        "properties": {
          "recording_id": {"type": "string", "pattern": "^(datased|datasec|upload):.+$"},
          "text": {"type": "string"},
          "score": {"type": "number"}
        }
      }
    }
  }
}
