{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://environmental-audio-rag.local/contracts/run_manifest.schema.json",
  "title": "Training run manifest",
  "description": "Reproducibility metadata emitted for each training run.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "command",
    "config",
    "class_ids",
    "taxonomy_sha256",
    "split_sha256",
    "git",
    "environment",
    "complete"
  ],
  "properties": {
    "manifest_version": {"type": "integer", "const": 2},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "config": {"type": "object"},
    "class_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
    },
    "taxonomy_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "split_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "data_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "config_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "feature_config_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "postproc_sha256": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "seed": {"type": "integer"},
    "seeds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "numpy", "torch", "cuda"],
      "properties": {
        "python": {"type": "integer", "minimum": 0},
        "numpy": {"type": "integer", "minimum": 0},
        "torch": {"type": "integer", "minimum": 0},
        "cuda": {"type": "integer", "minimum": 0}
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "dirty"],
      "properties": {
        "revision": {"type": "string", "minLength": 1},
        "dirty": {"type": "boolean"}
      }
    },
    "environment": {"type": "object"},
    "provisional": {"type": "boolean"},
    "branch": {"type": "string", "minLength": 1},
    "checkpoint_selection_rule": {"type": "string", "minLength": 1},
    "primary_metric": {"type": "string", "minLength": 1},
    "wall_clock_s": {"type": ["number", "null"], "minimum": 0},
    "predictions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dev": {"$ref": "#/$defs/artifactReference"},
        "test": {"$ref": "#/$defs/artifactReference"}
      }
    },
    "complete": {"type": "boolean"},
    "best_checkpoint": {"type": ["string", "null"], "minLength": 1},
    "postproc": {"type": "object"}
  },
  "$defs": {
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["manifest_version"],
        "properties": {"manifest_version": {"const": 2}}
      },
      "then": {
        "required": [
          "config_sha256",
          "data_manifest_sha256",
          "feature_config_sha256",
          "postproc_sha256",
          "predictions",
          "seeds",
          "provisional",
          "branch",
          "checkpoint_selection_rule",
          "primary_metric",
          "wall_clock_s",
          "best_checkpoint"
        ]
      }
    }
  ]
}
