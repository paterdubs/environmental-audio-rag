{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://environmental-audio-rag.local/contracts/timeline.schema.json",
  "title": "Event timeline",
  "description": "The only input accepted by the grounded captioner.",
  "type": "object",
  "additionalProperties": false,
  "required": ["recording_id", "duration_s", "taxonomy_version", "model_version", "events"],
  "properties": {
    "recording_id": {"type": "string", "pattern": "^(datased|datasec|upload):.+$"},
    "duration_s": {"type": "number", "exclusiveMinimum": 0},
    "taxonomy_version": {"type": "string", "minLength": 1},
    "model_version": {"type": "string", "minLength": 1},
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "class_id", "onset_s", "offset_s", "score"],
        "properties": {
          "event_id": {"type": "integer", "minimum": 1},
          "class_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "onset_s": {"type": "number", "minimum": 0},
          "offset_s": {"type": "number", "exclusiveMinimum": 0},
          "score": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    }
  }
}
